# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Archivos intermedios y copias locales generadas por los notebooks
/data/dataset_unificado_inicial.csv
/notebooks/data/
/notebooks/datos crudos/

# Excel originales provistos por la cátedra
/data/raw/

# Ignorar datos procesados generados por código
data/processed/*.csv
data/processed/preprocesador.joblib
!data/processed/.gitkeep

# Resultados detallados de cada trial de Optuna (se regeneran al optimizar)
/results/optuna_trials_*.csv

# Modelos experimentales; los modelos finales con versión sí se guardan en Git
/models/*.joblib
/models/*.pkl
/models/*.pickle
!/models/modelo_v*.pkl
